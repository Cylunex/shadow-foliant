#!/usr/bin/env python3
from contextlib import redirect_stdout
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
from core.research_errors import ResearchRejection

CATALOG = [
    {
        "name": "claim",
        "description": "A successful grant is idempotent only with the same explicit claim_id, owner and worker. "
                       "Without a key, or after an empty queue, claim polls for available work.",
        "inputSchema": {"type": "object", "properties": {
            "claim_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        }, "additionalProperties": False},
        "annotations": {"idempotentHint": True},
    },
    {"name": "status", "inputSchema": {"type": "object"}},
    {"name": "submit", "inputSchema": {"type": "object"}},
]


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--config", required=True)
    p.add_argument("command", choices=["catalog", "call"])
    p.add_argument("name", nargs="?")
    args = p.parse_args()
    if args.command == "catalog":
        return CATALOG
    if args.name not in {"claim", "status", "submit"}:
        raise ResearchRejection("unknown_operation")

    import _bootstrap  # noqa: F401
    from application.losna_research import LosnaResearch, PURPOSES
    from data.research_store import ResearchStore

    try:
        config = json.loads(Path(args.config).read_text())
    except (OSError, ValueError):
        raise ResearchRejection("invalid_config") from None
    if (not isinstance(config, dict)
            or not all(isinstance(config.get(k), str) and config[k].strip() for k in ("owner", "worker"))
            or not isinstance(config.get("purposes"), list) or not config["purposes"]
            or not all(isinstance(purpose, str) and purpose in PURPOSES for purpose in config["purposes"])):
        raise ResearchRejection("invalid_config")
    owner, worker = config["owner"], config["worker"]
    purposes = config["purposes"]
    raw = sys.stdin.read(262145)
    if len(raw) > 262144:
        raise ResearchRejection("input_too_large")
    try:
        data = json.loads(raw or "{}")
    except ValueError:
        raise ResearchRejection("invalid_input") from None
    if not isinstance(data, dict):
        raise ResearchRejection("invalid_input")
    service = LosnaResearch(ResearchStore(ensure_schema=False))
    if args.name == "claim":
        if set(data) - {"claim_id"} or (data.get("claim_id") is not None and
                (not isinstance(data["claim_id"], str) or not 1 <= len(data["claim_id"]) <= 200)):
            raise ResearchRejection("invalid_claim_identity")
        return service.claim(owner=owner, worker=worker, purposes=purposes, claim_id=data.get("claim_id"))
    if not isinstance(data.get("identity"), str) or not data["identity"]:
        raise ResearchRejection("invalid_input")
    old = service.get(data["identity"], owner)
    if old["packet"]["purpose"] not in purposes:
        raise ResearchRejection("purpose_denied")
    if args.name == "status":
        return old
    if "generation" not in data:
        raise ResearchRejection("invalid_input")
    return service.submit(identity=data["identity"], owner=owner, worker=worker,
                          generation=data["generation"], result=data.get("result"))


if __name__ == "__main__":
    try:
        with redirect_stdout(sys.stderr):
            result = main()
        sys.__stdout__.write(json.dumps(result, ensure_ascii=False) + "\n")
    except ResearchRejection as exc:
        rejection = {"isError": True, "code": str(exc)}
        if exc.identity is not None:
            rejection["object_id"] = exc.identity
        sys.__stdout__.write(json.dumps(rejection) + "\n")
        sys.exit(1)
    except Exception:
        # A connection can fail after commit. Only the original status can settle it.
        sys.__stdout__.write(json.dumps({"isError": True, "code": "outcome_unknown"}) + "\n")
        sys.exit(1)
