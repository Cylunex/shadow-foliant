#!/usr/bin/env python3
"""One JSON request per process; run with the Foliant runtime's Python environment."""
from contextlib import redirect_stdout
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[4]))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    parser.add_argument('command', choices=['catalog', 'call'])
    parser.add_argument('name', nargs='?')
    args = parser.parse_args()
    config = json.loads(Path(args.config).read_text())
    if (not isinstance(config, dict) or not isinstance(config.get('actor'), str)
            or not config['actor'].strip() or len(config['actor']) > 160
            or type(config.get('allow_writes', False)) is not bool):
        raise ValueError('invalid_config')
    from application.personal_skill import catalog, invoke
    if args.command == 'catalog':
        return catalog(config)
    raw = sys.stdin.buffer.read(262145)
    if len(raw) > 262144:
        raise ValueError('input_too_large')
    values = json.loads(raw or b'{}', parse_constant=lambda _: (_ for _ in ()).throw(ValueError('non_finite_number')))
    # Existing private Foliant .env remains a compatibility input for its business modules.
    import _bootstrap  # noqa: F401
    from application.results import clean_json
    return clean_json(invoke(args.name, values, config))


if __name__ == '__main__':
    try:
        with redirect_stdout(sys.stderr):
            result = main()
        sys.__stdout__.write(json.dumps(result, ensure_ascii=False, allow_nan=False) + '\n')
    except Exception as exc:
        code = getattr(exc, 'code', None) or type(exc).__name__
        result = {'isError': True, 'code': code}
        if type(exc).__name__ == 'ValidationError':
            result['fields'] = [{'path': list(e['loc']), 'type': e['type']} for e in exc.errors()]
        elif isinstance(exc, ValueError) and str(exc) in {'provide_rows_or_table', 'provide_batch_id_or_idempotency_key', 'input_too_large', 'invalid_config', 'capability_unavailable', 'non_finite_number', 'unknown_strategy_parameter', 'invalid_strategy_type', 'strategy_value_out_of_range', 'strategy_parameter_order'}:
            result['code'] = str(exc)
        sys.__stdout__.write(json.dumps(result, ensure_ascii=False) + '\n')
        sys.exit(1)
