# ============================================================
# AI股票分析系统环境配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 根据实际情况填写配置项
# 3. 敏感信息（如API密钥、密码）请妥善保管，不要提交到版本控制
# ============================================================

# ========== 网络代理 ==========
# 全项目统一代理入口，改一处即生效。留空则直连。
PROXY_URL=http://your_proxy_host:port

# ========== 问财登录（可选） ==========
# 匿名请求不以 Cookie 为硬前提；若生产节点频繁遇到鉴权/反爬，可从已登录
# iwencai 页面请求头复制 Cookie 以提高稳定性。敏感值禁止提交到 Git。
PYWENCAI_COOKIE=

# ========== Redis 缓存 ==========
# 可选。用于知识库结果缓存、分布式锁等
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
# 或使用单行 URL: REDIS_URL=redis://your_host:6379/0

# ========== 嵌入与重排 ==========
# RAG 已退出默认链路；只有显式开启才启用摄取、检索、工作流数据块和补充证据。
RAG_ENABLED=false
# BGE-M3 嵌入服务（向量检索用）
BGE_URL=http://your_embed_server:11434/v1/embeddings
# TEI Reranker 重排服务（精排召回结果）
TEI_RERANK_URL=http://your_rerank_server:8080

# ========== 通知渠道 ==========
# QQ 机器人 Webhook（与 QQ bot endpoint 对接）
QQ_WEBHOOK_URL=http://127.0.0.1:18888/webhook/qq
# NOTIFICATION_ROUTE_ALERT=qq
# NOTIFICATION_ROUTE_REPORT=email,dingtalk

# ========== LLM API 配置 ==========
# 方舟（Ark）API 密钥 / 兼容 OpenAI SDK 的 API 密钥
# 获取地址：https://console.volcengine.com/ark
DEEPSEEK_API_KEY=your_api_key_here

# 方舟（Ark）API 地址 / 兼容 OpenAI SDK 的 base_url
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ========== 妙想(东方财富 AI SaaS)外部服务配置 ==========
# 可选。MCP 工具 mx_*(个股诊断/热点/可比/资讯搜索/宏观/研报)用,定位"第二意见/外部数据"。
EM_API_KEY=your_em_key_here

# AI模型名称（可选，支持OpenAI兼容的任意模型）
# 常用模型：deepseek-v4-pro, qwen-plus, gpt-4o 等
DEFAULT_MODEL_NAME=deepseek-v4-pro

# 当前组合仓位模式。high 时，所有自动 buy/add 信号只有在 10:05 五档动作达到“强力买入”时放行；
# “适度买入”只作组合提示，不自动放行个股买入。判断缺失时默认不买。
PORTFOLIO_POSITION_MODE=normal

# 组合五档动作阈值（其余急跌/连续下杀/趋势参数沿用 MARKET_ADD_* 默认值）
# MARKET_ACTION_BUY_DIP_PCT=0.8    # 普遍回调达到此中位跌幅，可判“适度买入”
# MARKET_ACTION_TRIM_RALLY_PCT=1.8 # 普涨达到此中位涨幅，高仓位可判“适度卖出”

# 盘后全量策略进化运行日（ISO 周几：1=周一…5=周五）。其他交易日只跑轻量策略扫描。
DAILY_BACKTEST_FULL_WEEKDAYS=1,3,5

# 深度分析/选股专用模型（默认跟随 DEFAULT_MODEL_NAME）
# DEEPSEEK_MODEL=deepseek-v4-pro
# 思维链模型（可选，用于复杂推理，留空则不启用 thinking）
# DEEPSEEK_THINKING_MODEL=

# 多因子选股池(指数成分股)。默认 000510=中证A500(逐行业龙头/ESG/横跨大中小,比沪深300更均衡偏新经济)。
# 可选 000300沪深300 / 000905中证500 / 000852中证1000。改它即对选股池做 A/B(缓存键含指数码,切换不串味)。
# SELECTION_INDEX_UNIVERSE=000510

# 本地 PIT 选股主链：问财只保存为参考，不参与以下阶段的评分与准入。
LOCAL_SELECTION_FUNDAMENTAL_TOP_N=200
LOCAL_SELECTION_TECHNICAL_TOP_N=50
LOCAL_SELECTION_DIVERSIFIED_TOP_N=20
LOCAL_SELECTION_FINAL_N=15
LOCAL_SELECTION_MIN_HISTORY_DAYS=70
LOCAL_SELECTION_PREFERRED_HISTORY_DAYS=400
LOCAL_SELECTION_MAX_PER_INDUSTRY=3
LOCAL_SELECTION_MIN_WAREHOUSE_COVERAGE=0.80
LOCAL_SELECTION_MIN_VALUATION_COVERAGE=0.70
LOCAL_SELECTION_MIN_FINANCIAL_COVERAGE=0.70
LOCAL_SELECTION_MIN_FUNDAMENTAL_METRICS=4
LOCAL_SELECTION_MIN_LISTING_TRADING_DAYS=70
LOCAL_SELECTION_MIN_AVERAGE_AMOUNT_20=20000000
LOCAL_SELECTION_MIN_CORRELATION_DAYS=40
RESEARCH_MIN_UNIVERSE_ROWS=3000
RESEARCH_DAILY_MIN_COVERAGE=0.90
# zzshare 全市场快照缺口只做有界修补，避免 TDX/BaoStock 逐股风暴。
RESEARCH_FALLBACK_SYMBOLS_PER_RUN=100

# WebUI 跨源白名单(CORS)。默认只放行本机同源(localhost/127.0.0.1:8601/8600),SPA 与 API 同源
# 不受影响。原 allow_origins=* 有安全洞(恶意网页可跨源改 .env/触发任务),已收敛。
# 需从别的域访问时填逗号分隔来源;设 * 恢复旧的全放行(不建议,尤其对公网暴露时)。
# WEBUI_ALLOWED_ORIGINS=

# ========== Shadow Identity（Stock Web 必需）==========
# 浏览器只访问 stock 的规范入口；生产值和 client secret 均由仓库外受限配置注入。
SHADOW_OIDC_ISSUER=https://auth.example.com
SHADOW_OIDC_CLIENT_ID=shadow-stock
SHADOW_OIDC_CLIENT_SECRET_FILE=./secrets/oidc-client-secret
SHADOW_OIDC_REDIRECT_URI=https://stock.example.com/auth/callback
SHADOW_OIDC_POST_LOGOUT_REDIRECT_URI=https://stock.example.com/
SHADOW_OIDC_REQUIRED_GROUP=stock-users
SHADOW_OIDC_ADMIN_GROUP=stock-admins
# SHADOW_OIDC_SESSION_TTL_SECONDS=43200
# SHADOW_OIDC_TRANSACTION_TTL_SECONDS=600

# ========== Shadow Agent / LLM（服务端进程内）==========
# shadow-platform wheel 必须安装在 Foliant venv；registry 与 secrets 只读挂载，不进仓库。
SHADOW_AGENT_REGISTRY_FILE=./config/agent-registry.local.yml
SHADOW_LLM_REGISTRY_FILE=./config/llm-registry.local.yml
SHADOW_PLATFORM_SECRETS_DIR=./secrets
SHADOW_LLM_ENABLED=true
SHADOW_LLM_CHAT_ALIAS=chat-default
SHADOW_LLM_REASONING_ALIAS=reasoning-default
# DeepSeek 等模型会把 reasoning tokens 计入输出上限；过小会只有推理、正文为空。
SHADOW_LLM_MIN_OUTPUT_TOKENS=2000
SHADOW_LLM_USAGE_OUTBOX=./data/llm-usage.jsonl


# ========== LLM 降级 provider（全部可选 / 全部按 OpenAI 兼容 SDK 接入）==========
# 规则:每个 provider 必须同时配置 <NAME>_API_KEY 和 <NAME>_BASE_URL 才会进入降级链;
#       否则该 provider 直接跳过, 不会出现"打了降级日志但没下家"的情况。
# 顺序:默认按下面 1→6 优先级降级;可用 LLM_PROVIDER_ORDER 改顺序(逗号分隔)。
# 第三方中转 / 自建反代 直接改 <NAME>_BASE_URL 即可, 无需改代码。
#
# LLM_PROVIDER_ORDER=deepseek,siliconflow,tongyi
# LLM_TIMEOUT=40            # 单 provider 调用超时(秒), thinking 模型至少 120

# 1. 硅基流动(国内聚合, 含 DeepSeek/Qwen 等)
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# SILICONFLOW_THINKING_MODEL=deepseek-ai/DeepSeek-R1

# 2. 阿里通义千问(TONGYI_* 与 DASHSCOPE_* 同义)
# TONGYI_API_KEY=
# TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TONGYI_MODEL=qwen-plus
# TONGYI_THINKING_MODEL=qwq-plus

# 3. Google Gemini(OpenAI 兼容端点)
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_THINKING_MODEL=gemini-2.5-pro

# 4. OpenRouter 聚合
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_THINKING_MODEL=anthropic/claude-3.7-sonnet:thinking

# 5. Anthropic Claude(CLAUDE_* 与 ANTHROPIC_* 同义)
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-3-5-sonnet-latest
# CLAUDE_THINKING_MODEL=claude-3-7-sonnet-latest

# 6. 本地 Ollama(无需 API key, 只看 BASE_URL 探活;留空 → 不激活)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_THINKING_MODEL=deepseek-r1:14b


# ========== PostgreSQL 数据后端（必需）==========
# 运行时只有 PostgreSQL；真实连接信息只写服务器受限配置。
PG_HOST=db.example.com
PG_PORT=5432
PG_DATABASE=shadow_stock
PG_USER=shadow_stock
PG_PASSWORD=


# ========== Tushare数据接口（可选）==========
# Tushare Token（可选，用于获取更多金融数据）
# 获取地址：https://tushare.pro/register
TUSHARE_TOKEN=

# ========== A股分钟行情（可选但推荐）==========
# Token 只写本机/服务器 .env，不写代码、日志或数据库。
ZZSHARE_TOKEN=
ZZSHARE_ENABLED=true
ZZSHARE_TIMEOUT=15
# 接口契约可按 SOURCE_<PROVIDER>_<ENDPOINT>_* 覆盖；只允许比供应商硬限制更保守。
# SOURCE_ZZSHARE_REALTIME_MIN_INTERVAL_SECONDS=3.1
# SOURCE_ZZSHARE_FINANCE_PIT_TIMEOUT_SECONDS=30

# Python 3.10+ 的生产 TDX 主兜底；固定节点只写服务器受限配置。
TDX_USE_ELTDX=true
ELTDX_HOSTS=
ELTDX_PROXY_URL=
ELTDX_TIMEOUT=8
ELTDX_POOL_SIZE=2
ELTDX_BATCH_SIZE=80

# Python 3.12+ 的增强 TDX 兜底；SDK 在隔离子进程运行，避免节点信息进入日志。
TDX_USE_TDX_PYTHON=true
TDX_PYTHON_ADDRESS=
TDX_PYTHON_TIMEOUT_MS=5000
TDX_PYTHON_START_TIMEOUT=8
TDX_PYTHON_REQUEST_TIMEOUT=10

# easy-tdx 旧协议仅作末级兼容；留空 EASY_TDX_HOST 时自动选优。
TDX_USE_EASY_TDX=false
EASY_TDX_HOST=
EASY_TDX_TIMEOUT=8
EASY_TDX_PING_TIMEOUT=0.8
MARKET_DATA_MAX_BARS=3200
DATAHUB_INTRADAY_KLINE_TTL_SEC=60


# ========== MiniQMT量化交易配置（可选）==========
# 是否启用MiniQMT量化交易接口
MINIQMT_ENABLED=false

# MiniQMT账户ID
MINIQMT_ACCOUNT_ID=

# MiniQMT服务器地址
MINIQMT_HOST=127.0.0.1

# MiniQMT服务器端口
MINIQMT_PORT=58610

# ========== 下单风控门(fail-closed,AI盯盘自动下单前校验)==========
# 留空用默认。任一硬约束不满足则拒单。
# RISK_GATE_EXCLUDE=          # 排除名单,逗号分隔代码,如 600519,000001
# RISK_GATE_ALLOW_ST=false    # 是否允许买 ST/退市风险股
# RISK_GATE_SINGLE_MAX_PCT=25 # 买入后单票占总资产上限%
# RISK_GATE_TOTAL_MAX_PCT=95  # 买入后总仓位上限%
# RISK_GATE_MAX_DAILY_ORDERS=20  # 日内下单次数上限
# RISK_GATE_MAX_SINGLE_ORDER=0   # 单笔金额上限(元,0=不限)
# RISK_GATE_LIMIT_PCT=9.7     # 追涨停阈值(主板,当日涨幅≥此拒买)
# RISK_GATE_LIMIT_PCT_STAR=19.7  # 创业板/科创板涨停阈值


# ========== 邮件通知配置（可选）==========
# 是否启用邮件通知
EMAIL_ENABLED=false

# SMTP服务器地址
# 常用邮箱SMTP服务器：
#   - 163邮箱：smtp.163.com
#   - QQ邮箱：smtp.qq.com
#   - Gmail：smtp.gmail.com
#   - 企业邮箱：根据邮箱服务商提供的信息填写
SMTP_SERVER=smtp.163.com

# SMTP服务器端口
# 常用端口：
#   - 465：SSL加密连接163邮箱常用（推荐）
#   - 587：TLS加密连接
SMTP_PORT=465

# 发件人邮箱地址
EMAIL_FROM=your_email@163.com

# 邮箱授权码（不是登录密码！）
# 获取方法：
#   - 163邮箱：设置 -> POP3/SMTP/IMAP -> 开启服务 -> 获取授权码
#   - QQ邮箱：设置 -> 账户 -> POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 -> 开启服务 -> 生成授权码
EMAIL_PASSWORD=your_email_authorization_code

# 收件人邮箱地址（接收通知的邮箱）
EMAIL_TO=receiver@example.com


# ========== 通知分类路由（精细控制每类消息走哪些渠道）==========
# 每类消息可以独立指定走哪些渠道, 逗号分隔。可选值:
#   qq / email / dingtalk / feishu / wechat_work / telegram / discord / slack
# 留空 → 用代码默认。常见组合:
#   只走 QQ:      NOTIFICATION_ROUTE_XXX=qq
#   只走邮件:     NOTIFICATION_ROUTE_XXX=email
#   两个都收:     NOTIFICATION_ROUTE_XXX=qq,email
#
# 即时告警(止盈/止损/监控触发/任务失败) — 默认只发 QQ, 想加邮件改下面这行
# NOTIFICATION_ROUTE_ALERT=qq,email
# 日常报告(晨报/早盘/尾盘/选股/进化日报)
# NOTIFICATION_ROUTE_REPORT=qq
# 存档长文(周报/AI 评估周报等, 需留档检索) — 默认 email+qq, 不要邮件改下面这行
# NOTIFICATION_ROUTE_ARCHIVE=email,qq
# 系统错误/任务失败
# NOTIFICATION_ROUTE_SYSTEM_ERROR=qq
# 每日汇总(盈亏快照)
# NOTIFICATION_ROUTE_DAILY_SUMMARY=qq


# ========== Webhook通知配置（可选）==========
# 是否启用Webhook通知（钉钉/飞书）
WEBHOOK_ENABLED=false

# Webhook类型
# 可选值：dingtalk（钉钉）、feishu（飞书）
WEBHOOK_TYPE=dingtalk

# Webhook地址
# 钉钉机器人：https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN
# 飞书机器人：https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK_ID
WEBHOOK_URL=

# Webhook自定义关键词（仅钉钉需要）
# 说明：
#   - 如果钉钉机器人设置了"自定义关键词"安全验证，请在此填写关键词
#   - 系统会自动在消息标题和内容中包含此关键词
#   - 如果不使用关键词验证，可以留空或使用其他安全方式（加签、IP白名单）
#   - 飞书机器人通常不需要关键词，可以留空
# 示例：aiagents通知
WEBHOOK_KEYWORD=


# ========== 多渠道推送路由（可选）— 由 notification_router.py 使用 ==========
# 企业微信群机器人 Webhook
WECHAT_WORK_WEBHOOK=

# Telegram Bot（在 BotFather 申请）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord 频道 Webhook
DISCORD_WEBHOOK_URL=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# 路由配置（可选）— 留空则按类型发送到所有可用渠道
# 用逗号分隔渠道名（email/dingtalk/feishu/wechat_work/telegram/discord/slack）
# NOTIFICATION_ROUTE_ALERT=dingtalk,telegram
# NOTIFICATION_ROUTE_REPORT=email,wechat_work
# NOTIFICATION_ROUTE_SYSTEM_ERROR=telegram
# NOTIFICATION_ROUTE_DAILY_SUMMARY=email,wechat_work


# ========== 时区配置 ==========
# 系统时区设置（可选）
TZ=Asia/Shanghai


# ========== TDX数据源API配置（策略监控必须）==========
# TDX API服务地址
# 说明：
#   - 用于获取股票K线数据和技术指标
#   - 默认本地服务地址：http://127.0.0.1:5000
#   - 如果使用远程服务，请修改为实际地址
# API接口：
#   - /api/kline?code=000001&type=day  # 获取日K线数据
#   - /api/quote?code=000001           # 获取实时行情
#   - /api/health                      # 健康检查
TDX_BASE_URL=http://127.0.0.1:8181


# ========== 低价擒牛策略监控配置 ==========
# 扫描间隔（秒）
# 说明：
#   - 监控服务扫描股票的时间间隔
#   - 建议范围：30-300秒
#   - 默认值：60秒（每分钟扫描1次）
LOW_PRICE_BULL_SCAN_INTERVAL=60

# 持股天数限制
# 说明：
#   - 持股达到该天数后自动提醒卖出
#   - 按自然日计算，不区分交易日
#   - 默认值：5天
LOW_PRICE_BULL_HOLDING_DAYS=5


# ========== 项目启动时自动拉起后台服务/调度（autostart.py）==========
# 总开关
AUTOSTART_ENABLED=true

# 价格监测（含交易时段自动启停调度）— 推荐开
AUTOSTART_MONITOR=true

# Jobs Hub（完整时间表见 jobs/schedule_policy.py；夜间最迟按预算 23:25 收尾）— 推荐开
AUTOSTART_JOBS_HUB=true

# Agent/Web 手动任务由 Jobs Hub 从持久队列消费；建议 NAS 保持 1，最多 2。
MANUAL_TASK_WORKERS=1

# 盘后依赖任务在调度器 deferred 队列等待 K 线预热完成的最长秒数；
# 等待期间不占业务 worker，也不消耗子任务自身执行超时。
KLINE_PREFETCH_WAIT_SEC=2700
# 可选独立覆盖所有定时任务的依赖等待窗口；未设时沿用上值。
# JOB_DEPENDENCY_WAIT_SEC=2700

# 低价擒牛策略监测（持仓>0 时自动判断卖出信号）— 持仓存在时建议开
AUTOSTART_LOW_PRICE_BULL=false

# 新闻流量调度（30min 同步热点 / 60min 预警 / 120min 深度分析；周末深析自动避开 09–12、14–18）
AUTOSTART_NEWS_FLOW=false

# 智策板块每日 AI 分析（消耗 AI token，按需开启；平日不变，周末自动避开禁用窗口）
AUTOSTART_SECTOR_STRATEGY=false
SECTOR_STRATEGY_TIME=09:00

# 持仓定时分析（消耗 AI token，按需开启；平日不变，周末自动避开禁用窗口）
AUTOSTART_PORTFOLIO=false
